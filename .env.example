# =========================================
# Distanterra API - variables de entorno
# Copiar este archivo a ".env" y completar con valores reales.
# NUNCA commitear el archivo ".env" real.
# =========================================

# --- App ---
NODE_ENV=development
PORT=3001
# URL base pública de esta API (se usa para construir URLs absolutas de archivos de imágenes)
API_URL=http://localhost:3001

# --- CORS ---
# Lista separada por comas de los orígenes del frontend permitidos
CORS_ORIGINS=http://localhost:5173

# --- Login secreto de administrador ---
# El endpoint de login NO está en una ruta predecible como /auth/login.
# Se sirve en POST {ADMIN_LOGIN_PATH}. Cambiar este valor en cada despliegue.
ADMIN_LOGIN_PATH=/gestion-x9k2/acceso

# --- JWT ---
# Usar una cadena aleatoria larga, por ejemplo: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=1h
# Nombre de la cookie httpOnly que almacena el JWT
JWT_COOKIE_NAME=distanterra_admin_session

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=distanterra
DB_PASSWORD=change-this-password
DB_NAME=distanterra_db
# Poner en true solo si el proveedor de Postgres requiere SSL (en la mayoría de VPS: false)
DB_SSL=false

# --- Subida de archivos ---
# Ruta absoluta o relativa (desde la raíz del proyecto) donde se guardan las imágenes subidas en el disco de la VPS
UPLOADS_DIR=./uploads
# Tamaño máximo de subida en bytes (por defecto 5MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# --- Rate limiting general (aplica a todos los endpoints) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60

# --- Rate limiting del login (más estricto, protección contra fuerza bruta) ---
LOGIN_THROTTLE_TTL_SECONDS=60
LOGIN_THROTTLE_LIMIT=5

# --- Seed inicial del administrador (solo usado por "npm run db:seed-admin") ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-password
